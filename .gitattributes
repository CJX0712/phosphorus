# 统一行尾：所有文本文件以 LF 入库（Windows 检出也保持 LF，避免 CRLF 警告）。
* text=auto eol=lf

# 语料与数据：明确按文本处理，禁止被二进制探测误判。
*.txt text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.c text eol=lf
*.h text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf

# 真正的二进制产物：禁用换行转换与 diff。
*.bin binary
*.phos binary
*.pt binary
*.pkl binary
*.png binary
